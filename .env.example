# Copy to .env.local and add values from Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Set this to the canonical public origin before production deployment
# NEXT_PUBLIC_SITE_URL=https://your-real-domain.example

# Server-only seed script settings. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_SEED_PASSWORD=
# Remote seeding is blocked unless explicitly enabled for a dedicated dev/staging project.
ALLOW_REMOTE_DEMO_SEED=false
